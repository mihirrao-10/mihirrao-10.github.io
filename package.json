{
  "name": "mihirrao-personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mihir Rao's static personal website",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build:experience && node tools/build-site.js",
    "test": "node --test tests/black-geometry/*.test.js",
    "check": "npm test && npm run build && npm run verify:experience && npm run verify:site",
    "build:experience": "node tools/black-geometry/build.js",
    "verify:experience": "node tools/black-geometry/build.js --check",
    "test:experience": "node --test tests/black-geometry/*.test.js",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/ms-playwright playwright test",
    "verify:site": "node tools/black-geometry/verify-site.js"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "parse5": "8.0.1"
  }
}
